# ===== Rama Riot dev (single-user: AlexRomero12#lan) =====
# La API oficial se usa hoy con DEV KEY (expira cada 24h; regenerar en
# https://developer.riotgames.com). Los endpoints de partidas (VAL-MATCH-V1)
# responden 403 con dev key: RIOT_MATCH_SOURCE=mock sirve los fixtures
# generados desde el archivo real (mismos DTOs que producción).
RIOT_API_KEY=
# mock (default en dev) | live (al tener la key productiva)
RIOT_MATCH_SOURCE=mock

# Cuenta única de esta rama (VAL_NAME/VAL_TAG). AlexRomero12#lan.
VAL_NAME=AlexRomero12
VAL_TAG=LAN
# Routing oficial: cluster de cuenta (americas/europe/asia) y plataforma del
# match API (na/latam/br/eu/ap/kr). LAN usa cluster americas y plataforma latam.
VAL_CLUSTER=americas
VAL_SHARD=latam

# ===== Refresco en background (opcional) =====
# Mantiene el bucket de partidas caliente y archiva cada partida nueva.
# 1 = activado | 0 (por defecto) = desactivado
VAL_BACKGROUND_REFRESH=0
# Intervalo del ciclo (minutos). Default: 15.
VAL_REFRESH_INTERVAL_MIN=15

# ===== Archivo acumulativo de partidas (persistente) =====
# Histórico eterno estilo tracker.gg: una partida archivada nunca se pierde.
# Default: data/archive (en Docker lo monta docker-compose como volumen)
# ARCHIVE_DIR=data/archive

# ===== Perfil único =====
# El perfil (Riot ID, rol, reglas de sesión) vive en data/profiles.json y se
# siembra desde VAL_NAME/VAL_TAG la primera vez. Se edita en /perfiles.

# ===== Aviso semanal de reglas (push) =====
# Lunes por la mañana manda un push con los hallazgos de la semana anterior
# (cortes ignorados / violaciones de pool). Requiere Web Push abajo.
# 1 = activado (default) | 0 = desactivado
# VAL_RULES_PUSH=1

# ===== Despliegue =====
# Zona horaria IANA del contenedor (afecta cortes de día y timestamps).
# TZ=UTC
# Límite del bucket de partidas por sync (default 40). No tocar salvo pruebas.
# REFRESH_COOLDOWN_SEC=10

# ===== Web Push (aviso semanal de reglas) =====
# Genera: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:valoia@localhost

# ===== Producto público (solicitud de production key de Riot) =====
# APP_MODE=single (default: instancia personal sin login) | public (multi-usuario)
# En public se activan: cuentas locales, vinculación Riot (RSO/mock) y opt-in.
# APP_MODE=public
# Obligatorio en public: firma las sesiones (32+ bytes base64url).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=
# Admin de moderación (opcional, se siembra si no hay usuarios):
# AUTH_USER=
# AUTH_PASSWORD=
# Identidad que permite el proveedor demo de vinculación (pre-aprobación):
# MOCK_RIOT_IDS=AlexRomero12#LAN
# Acceso demo para revisores (botón "Ver demo" en la landing; cuenta de solo
# lectura). 0 = deshabilita el endpoint; DEMO_USER cambia la cuenta.
# DEMO_LOGIN=0
# DEMO_USER=valoia-demo
# RSO real (solo tras la aprobación de Riot): RSO_ENABLED=1 + credenciales
# RSO_ENABLED=0
# RSO_CLIENT_ID=
# RSO_CLIENT_SECRET=
# RSO_REDIRECT_URI=https://TU-DOMINIO/api/riot/link/callback
