# ===== PROVEEDOR RECOMENDADO: Henrik API (gratis, key instantánea) =====
# 1) Entra al Discord de Henrik-3: https://discord.gg/henrikdev
# 2) Genera tu key en https://api.henrikdev.xyz/dashboard/
# 3) Pégala aquí:
HENRIK_API_KEY=

# Región para Henrik: na | eu | ap | kr (LAN/LATAM comparte deployment con na)
VAL_REGION=na
VAL_PLATFORM=pc

# ===== ALTERNATIVA: Riot API oficial =====
# (https://developer.riotgames.com — DEVELOPMENT KEY, expira cada 24h)
# NOTA: VAL-MATCH-V1 suele dar 403 con keys de desarrollo; se mantiene como fallback.
RIOT_API_KEY=
VAL_CLUSTER=americas
VAL_SHARD=latam

# Cuenta Valorant (riot id)
VAL_NAME=AlexRomero12
VAL_TAG=LAN

# ===== Refresco en background (opcional) =====
# Mantiene los buckets calientes: abrir el dashboard cuesta $0 requests a Henrik.
# 1 = activado | 0 (por defecto) = desactivado
VAL_BACKGROUND_REFRESH=0
# Intervalo del ciclo (minutos). Default: 15.
VAL_REFRESH_INTERVAL_MIN=15

# Aim Lab
AIMLAB_USERNAME=AlexRomero12
AIMLAB_USER_ID=23804C9D6C3A1F93
