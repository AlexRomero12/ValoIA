# ===== PROVEEDOR RECOMENDADO: Henrik API (gratis, key instantánea) =====
# 1) Entra al Discord de Henrik-3: https://discord.gg/henrikdev
# 2) Genera tu key en https://api.henrikdev.xyz/dashboard/
# 3) Pégala aquí:
HENRIK_API_KEY=

# Región para Henrik: na | eu | ap | kr (LAN/LATAM comparte deployment con na)
VAL_REGION=na
VAL_PLATFORM=pc

# ===== ALTERNATIVA: Riot API oficial =====
# (https://developer.riotgames.com — DEVELOPMENT KEY, expira cada 24h)
# NOTA: VAL-MATCH-V1 suele dar 403 con keys de desarrollo; se mantiene como fallback.
RIOT_API_KEY=
VAL_CLUSTER=americas
VAL_SHARD=latam

# Cuenta Valorant (riot id)
VAL_NAME=Player
VAL_TAG=LAN

# ===== Refresco en background (opcional) =====
# Mantiene los buckets calientes: abrir el dashboard cuesta $0 requests a Henrik,
# y cada partida nueva se archiva sola en el archivo acumulativo.
# 1 = activado | 0 (por defecto) = desactivado
VAL_BACKGROUND_REFRESH=0
# Intervalo del ciclo (minutos). Default: 15.
VAL_REFRESH_INTERVAL_MIN=15

# ===== Archivo acumulativo de partidas (persistente) =====
# Histórico eterno estilo tracker.gg: una partida archivada nunca se pierde,
# ni borrando el cache (.cache/) ni reiniciando el contenedor.
# Default: data/archive (en Docker lo monta docker-compose como volumen)
# ARCHIVE_DIR=data/archive

# ===== Perfiles =====
# Los perfiles (Riot ID, rol, reglas de auditoría) viven en data/profiles.json.
# La primera vez se siembran con el cuarteto original + las reglas de Player.
# Gestiona desde la pestaña "Perfiles" del dashboard.

# ===== Acceso (login) =====
# Obligatorio en producción: firma las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Usuario inicial: se crea en el primer login si aún no existe ningún usuario.
# Después se gestionan desde Perfiles → Usuarios (con solicitudes de acceso).
AUTH_USER=admin
AUTH_PASSWORD=
# Detrás de un proxy (Caddy/nginx): confiar en X-Real-IP/X-Forwarded-*.
# 1 = activado (producción con HTTPS) | 0 = desactivado (local)
# TRUST_PROXY=1
# Límites de sesiones simultáneas (por defecto 5 por usuario, 3 por IP)
# SESSION_MAX_PER_USER=5
# SESSION_MAX_PER_IP=3
# Límites de uso (por defecto 10 perfiles/usuario, 20 admin; refresh 10s)
# MAX_PROFILES=10
# MAX_PROFILES_ADMIN=20
# REFRESH_COOLDOWN_SEC=10

# ===== Auditoría semanal (push) =====
# Lunes por la mañana manda un push al admin con los hallazgos de la semana
# anterior (cortes ignorados / violaciones de pool). Requiere Web Push abajo.
# 1 = activado (default) | 0 = desactivado
# VAL_AUDIT_PUSH=1

# ===== Despliegue en producción =====
# Dominio con HTTPS (Caddy lo usa para el certificado). Solo hace falta en el
# servidor: ver docs/despliegue.md
# DOMAIN=valoia.tudominio.com

# ===== Tienda diaria + favoritas (RSO por usuario) =====
# Cada usuario conecta su tienda con su cookie ssid desde la página Tienda.
# Shard de pd.a.pvp.net para el storefront (latam/br/na -> na, eu -> eu, ap -> ap, kr -> kr)
STORE_SHARD=na
# Web Push (notificaciones de skins favoritas). Genera: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:valoia@localhost
# Respaldo RSO por usuario/pass (opcional, Riot exige hCaptcha en el login
# programático: la vía recomendada es pegar la cookie ssid desde la Tienda).
# VAL_RIOT_USER=
# VAL_RIOT_PASS=
